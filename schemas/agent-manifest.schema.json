{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:agent-manifest:1",
  "title": "Agent manifest",
  "description": "The declaration of one specialist agent: what it may do, what it needs, what it returns and how it is evaluated. There are no prompt-only agents with open shell or production access. Every agent names its tools, its limits and its output schema. An agent that can write files or run commands can only run inside a sandbox. The deterministic policy engine, not the agent, decides which declared tools are actually granted for a given stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "role",
    "domains",
    "skills",
    "allowed_tools",
    "required_evidence",
    "inputs_schema",
    "outputs_schema",
    "resource_limits",
    "permissions",
    "permitted_placements",
    "recommended_models",
    "evaluation_suite",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "title": {
      "$ref": "#/$defs/humanTitle"
    },
    "description": {
      "$ref": "#/$defs/humanText"
    },
    "role": {
      "$ref": "#/$defs/slug",
      "description": "A role such as architect, builder or code-reviewer. Roles are open-ended so new domains can add their own."
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "access"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "access": {
            "enum": [
              "read",
              "write",
              "execute_sandboxed"
            ]
          },
          "path_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Path globs the tool may touch."
          }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "inputs_schema": {
      "$ref": "#/$defs/schemaRef"
    },
    "outputs_schema": {
      "$ref": "#/$defs/schemaRef"
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_time_seconds",
        "max_tokens",
        "max_cost_usd",
        "max_tool_calls",
        "max_delegation_depth"
      ],
      "properties": {
        "max_wall_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "shell",
        "production_access",
        "secrets"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "network": {
          "enum": [
            "none",
            "allowlist"
          ]
        },
        "network_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shell": {
          "enum": [
            "none",
            "sandboxed_typed_wrapper"
          ],
          "description": "There is no value for unrestricted shell."
        },
        "production_access": {
          "const": "none"
        },
        "secrets": {
          "enum": [
            "none",
            "scoped_short_lived"
          ]
        }
      },
      "if": {
        "properties": {
          "network": {
            "const": "allowlist"
          }
        },
        "required": [
          "network"
        ]
      },
      "then": {
        "required": [
          "network_allowlist"
        ],
        "properties": {
          "network_allowlist": {
            "minItems": 1
          }
        }
      }
    },
    "permitted_placements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sandbox",
          "host_tool_bridge"
        ]
      },
      "description": "Where the agent runtime may run this agent. sandbox: the agent command line tool runs inside the hardened sandbox container. host_tool_bridge: the tool runs on the host with its built-in tools disabled and acts only through factory tools that execute in the sandbox. This is the hardening target and policy keeps it off in Slice 1. There is no value for running an agent directly on the host."
    },
    "recommended_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_id",
          "tier"
        ],
        "properties": {
          "runtime_id": {
            "$ref": "#/$defs/slug"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "small",
              "standard",
              "large"
            ]
          },
          "notes": {
            "$ref": "#/$defs/humanText"
          }
        }
      }
    },
    "evaluation_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "min_pass_rate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "min_pass_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_path",
        "template_version",
        "template_sha256"
      ],
      "properties": {
        "template_path": {
          "type": "string",
          "minLength": 1
        },
        "template_version": {
          "$ref": "#/$defs/semver"
        },
        "template_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed_tools": {
            "contains": {
              "properties": {
                "access": {
                  "const": "execute_sandboxed"
                }
              },
              "required": [
                "access"
              ]
            }
          }
        },
        "required": [
          "allowed_tools"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "shell": {
                "const": "sandboxed_typed_wrapper"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_tools": {
            "items": {
              "properties": {
                "access": {
                  "const": "read"
                }
              }
            }
          }
        },
        "required": [
          "allowed_tools"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "shell": {
                "const": "none"
              },
              "filesystem": {
                "properties": {
                  "write": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "description": "Content hash in the form sha256:<64 lowercase hex characters>.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen. For metadata fields, never for human-facing titles.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "semver": {
      "description": "Semantic version, for example 1.2.0.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "schemaRef": {
      "description": "Reference to a versioned JSON Schema by name, version and content hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
