{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:policy-model-routing:1",
  "title": "Model routing policy",
  "description": "The JSON form of policies/model_routing.yaml: which models each agent role may use, what a model costs, and how much a stage or a job may spend. It holds no key, no token and no address. Every number in the shipped file waits for the project owner. The loader in crates/contracts/src/policy/routing.rs checks the rules a schema cannot: that names refer to each other, that the ceilings are under the manifests and under policies/security.yaml, and that every rule of independence can be satisfied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "models", "roles", "routes", "independence", "job"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "default_action",
        "conflict_resolution",
        "project_overrides",
        "config_source",
        "threats"
      ],
      "properties": {
        "id": { "const": "model_routing" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["designed", "enforced"] },
        "default_action": { "const": "deny" },
        "conflict_resolution": { "const": "deny_overrides" },
        "project_overrides": { "const": "tighten_only" },
        "config_source": { "enum": ["protected_default_branch", "signed_release"] },
        "threats": { "type": "array", "items": { "$ref": "#/$defs/threatId" } }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_no_independent_model", "rules"],
      "properties": {
        "on_no_independent_model": { "const": "wait_for_human" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/independenceRule" } }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_micro_usd", "max_tokens"],
      "properties": {
        "max_micro_usd": { "$ref": "#/$defs/positiveCount" },
        "max_tokens": { "$ref": "#/$defs/positiveCount" }
      }
    }
  },
  "$defs": {
    "positiveCount": {
      "description": "A whole number of at least 1. Money is in millionths of a US dollar.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "threatId": {
      "type": "string",
      "pattern": "^T-[0-9]{2}$"
    },
    "modelName": {
      "description": "A model as the provider spells it: no white space.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"
    },
    "stageKind": {
      "type": "string",
      "enum": [
        "INTAKE",
        "REPOSITORY_INTELLIGENCE",
        "SPECIFICATION",
        "DOMAIN_DISCOVERY",
        "ARCHITECTURE",
        "TASK_PLANNING",
        "IMPLEMENTATION",
        "VALIDATION",
        "REVIEW",
        "DOCUMENTING",
        "DOCUMENTATION_REVIEW",
        "DELIVERY",
        "APPROVAL",
        "MERGE"
      ]
    },
    "tier": { "enum": ["small", "standard", "large"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "runtime",
        "family",
        "tier",
        "prices",
        "price_checked_on",
        "price_source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/modelName" },
        "provider": { "enum": ["anthropic", "openai"] },
        "runtime": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "tier": { "$ref": "#/$defs/tier" },
        "prices": {
          "description": "Millionths of a US dollar for a million tokens.",
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cache_write", "cache_read", "output"],
          "properties": {
            "input": { "$ref": "#/$defs/positiveCount" },
            "cache_write": { "$ref": "#/$defs/positiveCount" },
            "cache_read": { "$ref": "#/$defs/positiveCount" },
            "output": { "$ref": "#/$defs/positiveCount" }
          }
        },
        "price_checked_on": {
          "description": "The date a person read the price on the provider's page, or the word unchecked.",
          "type": "string",
          "pattern": "^(unchecked|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "price_source": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "stage",
        "allowed_models",
        "start_with",
        "escalate_to",
        "escalate_after_failed_repairs",
        "per_stage_run",
        "per_request"
      ],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "stage": { "$ref": "#/$defs/stageKind" },
        "allowed_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modelName" }
        },
        "start_with": { "$ref": "#/$defs/modelName" },
        "escalate_to": { "$ref": "#/$defs/modelName" },
        "escalate_after_failed_repairs": { "type": "integer", "minimum": 1, "maximum": 10 },
        "per_stage_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_micro_usd", "max_tokens"],
          "properties": {
            "max_micro_usd": { "$ref": "#/$defs/positiveCount" },
            "max_tokens": { "$ref": "#/$defs/positiveCount" }
          }
        },
        "per_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_tokens", "max_output_tokens"],
          "properties": {
            "max_input_tokens": { "$ref": "#/$defs/positiveCount" },
            "max_output_tokens": { "$ref": "#/$defs/positiveCount" }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "tier", "candidates"],
      "properties": {
        "stage": { "$ref": "#/$defs/stageKind" },
        "tier": { "$ref": "#/$defs/tier" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modelName" }
        }
      }
    },
    "independenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author_role", "reviewer_role", "must_differ_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
        "author_role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "reviewer_role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "must_differ_by": { "enum": ["model", "family", "provider"] }
      }
    }
  }
}
