{
  "schema_version": 1,
  "project": {
    "name": "word-count",
    "title": "Word count command line tool",
    "domain_tags": [
      "general-software",
      "command-line-tool"
    ],
    "default_branch": "main"
  },
  "sandbox": {
    "image": "rust-fixture",
    "workdir": "/workspace"
  },
  "gates": [
    {
      "id": "unit-tests",
      "title": "Run the tests and print the Test Anything Protocol",
      "argv": [
        "npm",
        "test"
      ],
      "timeout_seconds": 900,
      "mandatory": true,
      "test_report": {
        "format": "tap"
      }
    }
  ],
  "protected_paths": [
    ".factory/**",
    ".github/**",
    "CODEOWNERS"
  ],
  "spec_kit": {
    "cli_version": "1.1.2",
    "integration": "claude",
    "may_initialize": true
  },
  "documentation": {
    "required_documents": [
      {
        "path": "README.md",
        "purpose": "Explains what the tool does and how to use every option."
      }
    ],
    "changelog_path": "CHANGELOG.md"
  }
}
