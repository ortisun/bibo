{
  "schema_version": 1,
  "project": {
    "name": "word-count-py",
    "title": "Word count command line tool in Python",
    "domain_tags": [
      "general-software",
      "command-line-tool"
    ],
    "default_branch": "main"
  },
  "sandbox": {
    "image": "python-fixture",
    "workdir": "/workspace"
  },
  "gates": [
    {
      "id": "lint",
      "title": "Run the linter",
      "argv": [
        "ruff",
        "check",
        "."
      ],
      "timeout_seconds": 300,
      "mandatory": true,
      "test_report": {
        "format": "junit-xml",
        "path": "lint.xml"
      }
    },
    {
      "id": "unit-tests",
      "title": "Run the tests with pytest",
      "argv": [
        "pytest",
        "--junitxml=/out/test-report.xml",
        "-o",
        "cache_dir=/out/pytest-cache"
      ],
      "timeout_seconds": 900,
      "mandatory": true,
      "test_report": {
        "format": "junit-xml",
        "path": "test-report.xml"
      }
    }
  ],
  "protected_paths": [
    ".factory/**",
    ".github/**",
    "CODEOWNERS"
  ],
  "spec_kit": {
    "cli_version": "1.1.2",
    "integration": "claude",
    "may_initialize": true
  },
  "documentation": {
    "required_documents": [
      {
        "path": "README.md",
        "purpose": "Explains what the tool does and how to use every option."
      }
    ],
    "changelog_path": "CHANGELOG.md"
  }
}
