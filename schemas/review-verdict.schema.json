{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:review-verdict:1",
  "title": "Review verdict",
  "description": "The structured result of one independent review. The reviewer works from the frozen specification, the diff and verified gate evidence. It does not receive the builder's own account of the work. The verdict and the findings must agree: a PASS cannot carry a blocking finding, and every other verdict must explain itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "title", "verdict", "summary", "inputs_reviewed", "findings", "confidence_overall"],
  "properties": {
    "schema_version": { "const": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "job_id", "stage_run_id", "reviewer", "created_at", "execution_mode"],
      "properties": {
        "review_id": { "$ref": "#/$defs/uuid" },
        "job_id": { "$ref": "#/$defs/uuid" },
        "stage_run_id": { "$ref": "#/$defs/uuid" },
        "execution_mode": { "enum": ["production", "test"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "agent_version", "role", "runtime"],
          "properties": {
            "agent_id": { "$ref": "#/$defs/slug" },
            "agent_version": { "$ref": "#/$defs/semver" },
            "role": { "enum": ["code_reviewer", "security_reviewer", "reliability_reviewer", "ux_reviewer", "adversarial_reviewer", "documentation_reviewer", "specification_reviewer", "architecture_critic"] },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapter", "adapter_version", "fidelity"],
              "properties": {
                "adapter": { "$ref": "#/$defs/slug" },
                "adapter_version": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "fidelity": { "enum": ["real", "fake"] }
              }
            }
          }
        }
      }
    },
    "title": { "$ref": "#/$defs/humanTitle" },
    "verdict": { "enum": ["PASS", "CHANGES_REQUIRED", "BLOCK", "NEEDS_HUMAN"] },
    "summary": { "$ref": "#/$defs/humanText" },
    "inputs_reviewed": {
      "description": "What the engine gave the reviewer. The engine builds this list. The reviewer does not choose it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_spec_sha256", "diff_sha256", "gate_reports", "saw_builder_self_assessment"],
      "properties": {
        "frozen_spec_sha256": { "$ref": "#/$defs/sha256" },
        "diff_sha256": { "$ref": "#/$defs/sha256" },
        "gate_reports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_report_id", "sha256"],
            "properties": { "gate_report_id": { "$ref": "#/$defs/uuid" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "context_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
        "saw_builder_self_assessment": { "const": false, "description": "The reviewer input never includes the builder's summary or justification." }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "category", "title", "description", "confidence", "proposed_next_action", "defect_class"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/slug" },
          "severity": { "enum": ["blocker", "high", "medium", "low", "info"] },
          "category": { "enum": ["correctness", "concurrency", "security", "performance", "maintainability", "compatibility", "tests", "intent_alignment", "documentation", "accessibility", "other"] },
          "title": { "$ref": "#/$defs/humanTitle" },
          "description": { "$ref": "#/$defs/humanText" },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 }
            }
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": { "kind": { "enum": ["command", "test", "steps"] }, "detail": { "$ref": "#/$defs/humanText" } }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "proposed_next_action": { "enum": ["fix", "add_test", "clarify_specification", "escalate_to_human", "accept_risk"] },
          "defect_class": { "enum": ["code_behavior", "documentation", "specification", "policy"], "description": "Used to route a CHANGES_REQUIRED verdict (state-machine.json, pipeline.defect_routing). code_behavior goes to a new run of IMPLEMENTATION and documentation to DOCUMENTING, as the stage's rework route says. specification and policy are decisions for a person, so the stage run waits for one. When findings differ, specification wins over policy, policy over code_behavior and code_behavior over documentation." }
        }
      }
    },
    "confidence_overall": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_question": { "$ref": "#/$defs/humanText", "description": "Required when the verdict is NEEDS_HUMAN. One focused question." },
    "residual_risks": { "type": "array", "items": { "$ref": "#/$defs/humanText" } }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PASS" } }, "required": ["verdict"] },
      "then": { "properties": { "findings": { "items": { "properties": { "severity": { "enum": ["medium", "low", "info"] } } } } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "CHANGES_REQUIRED" } }, "required": ["verdict"] },
      "then": { "properties": { "findings": { "contains": { "properties": { "severity": { "enum": ["blocker", "high", "medium"] } }, "required": ["severity"] } } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "BLOCK" } }, "required": ["verdict"] },
      "then": { "properties": { "findings": { "contains": { "properties": { "severity": { "const": "blocker" } }, "required": ["severity"] } } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "NEEDS_HUMAN" } }, "required": ["verdict"] },
      "then": { "required": ["human_question"] }
    },
    {
      "if": { "properties": { "metadata": { "properties": { "execution_mode": { "const": "production" } } } }, "required": ["metadata"] },
      "then": { "properties": { "metadata": { "properties": { "reviewer": { "properties": { "runtime": { "properties": { "fidelity": { "const": "real" } } } } } } } } }
    }
  ],
  "$defs": {
    "uuid": { "description": "Lowercase UUID. Version 7 is recommended so identifiers sort by creation time.", "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "description": "Content hash in the form sha256:<64 lowercase hex characters>.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "description": "UTC instant in RFC 3339 form with a Z suffix.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "slug": { "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen. For metadata fields, never for human-facing titles.", "type": "string", "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$" },
    "semver": { "description": "Semantic version, for example 1.2.0.", "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        { "not": { "pattern": "\\|" } },
        { "not": { "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]" } },
        { "not": { "pattern": "^\\[[^\\]]+\\]" } },
        { "not": { "pattern": "\\[[A-Z_]+:[^\\]]*\\]" } }
      ]
    },
    "humanText": { "description": "Complete plain-English sentences written for a human reader.", "type": "string", "minLength": 10, "maxLength": 4000, "pattern": "^\\S([\\s\\S]*\\S)?$" },
    "artifactRef": {
      "description": "Pointer to an immutable stored artifact by content hash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "media_type"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
