{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:specification-contract:1",
  "title": "Specification contract",
  "description": "The typed form of an approved feature specification, extracted by the spec_adapter from the artifacts that GitHub Spec Kit produced. The original Spec Kit files stay the canonical text. This contract points to them by content hash and adds the structure that later stages need. Once status is approved the contract is frozen. A change makes a new spec_version and invalidates everything built on the old one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "title",
    "summary",
    "requirements",
    "acceptance_scenarios",
    "nonfunctional_requirements",
    "risks",
    "open_questions",
    "constraints",
    "out_of_scope",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "spec_version",
        "status",
        "job_id",
        "execution_mode",
        "commit_sha",
        "created_at"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/uuid"
        },
        "spec_version": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_spec_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "superseded"
          ]
        },
        "job_id": {
          "$ref": "#/$defs/uuid"
        },
        "execution_mode": {
          "enum": [
            "production",
            "test"
          ]
        },
        "commit_sha": {
          "$ref": "#/$defs/gitSha",
          "description": "Repository commit the specification was written against."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approved_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_id",
            "role",
            "basis"
          ],
          "properties": {
            "principal_id": {
              "$ref": "#/$defs/uuid"
            },
            "role": {
              "enum": [
                "approver",
                "operator",
                "policy_engine"
              ]
            },
            "basis": {
              "enum": [
                "human_decision",
                "low_risk_policy_with_passing_gate"
              ]
            }
          }
        }
      }
    },
    "title": {
      "$ref": "#/$defs/humanTitle"
    },
    "summary": {
      "$ref": "#/$defs/humanText"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "priority",
          "acceptance_scenario_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-[0-9]{3,}$",
            "description": "Identifier as written by Spec Kit. Machine metadata, not a title."
          },
          "statement": {
            "$ref": "#/$defs/humanText"
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ],
            "description": "Taken from the user story the requirement belongs to in the Spec Kit template."
          },
          "user_story_ref": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AS-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "acceptance_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "given",
          "when",
          "then",
          "requirement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AS-[0-9]{3,}$"
          },
          "user_story_ref": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "$ref": "#/$defs/humanText"
          },
          "when": {
            "$ref": "#/$defs/humanText"
          },
          "then": {
            "$ref": "#/$defs/humanText"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FR-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(NFR|SC)-[0-9]{3,}$",
            "description": "NFR for explicit non-functional requirements, SC for Spec Kit success criteria."
          },
          "statement": {
            "$ref": "#/$defs/humanText"
          },
          "metric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "target",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "likelihood",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RISK-[0-9]{3,}$"
          },
          "description": {
            "$ref": "#/$defs/humanText"
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "$ref": "#/$defs/humanText"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "blocking",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-[0-9]{3,}$"
          },
          "question": {
            "$ref": "#/$defs/humanText"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "deferred"
            ]
          },
          "answer": {
            "$ref": "#/$defs/humanText"
          },
          "source_marker": {
            "const": "NEEDS CLARIFICATION",
            "description": "Present when the question came from a Spec Kit clarification marker."
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "technical",
              "legal",
              "safety",
              "platform",
              "business"
            ]
          },
          "description": {
            "$ref": "#/$defs/humanText"
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanText"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_kit",
        "host_runtime",
        "artifacts",
        "source_request"
      ],
      "properties": {
        "spec_kit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cli_version",
            "integration"
          ],
          "properties": {
            "cli_version": {
              "type": "string",
              "minLength": 1,
              "description": "Value of speckit_version in .specify/init-options.json."
            },
            "integration": {
              "type": "string",
              "minLength": 1
            },
            "skills_invoked": {
              "type": "array",
              "items": {
                "enum": [
                  "constitution",
                  "specify",
                  "clarify",
                  "checklist"
                ]
              },
              "description": "Only these four skills may ever appear here."
            }
          }
        },
        "host_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "adapter_version",
            "fidelity"
          ],
          "properties": {
            "adapter": {
              "$ref": "#/$defs/slug"
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1
            },
            "fidelity": {
              "enum": [
                "real",
                "fake"
              ]
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path",
              "sha256"
            ],
            "properties": {
              "role": {
                "enum": [
                  "specification",
                  "requirements_checklist",
                  "custom_checklist",
                  "constitution",
                  "clarification_log"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Repository-relative path of the original Spec Kit file."
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "specification"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        "source_request": {
          "description": "The original untrusted request text is stored separately. This is its hash.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "language"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
            }
          }
        },
        "feature_directory": {
          "type": "string",
          "pattern": "^specs/[a-z0-9][a-z0-9._-]*$",
          "description": "Repository-relative Spec Kit feature directory. The factory chooses the name and sets SPECIFY_FEATURE_DIRECTORY explicitly. It is never inferred from the git branch."
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "basis_spec_version"
          ],
          "properties": {
            "method": {
              "enum": [
                "new_feature_directory",
                "clarify_in_place",
                "human_edit"
              ],
              "description": "Spec Kit has no supported in-place revision of spec.md. new_feature_directory is the proposed method and needs a spike (ADR 0006)."
            },
            "basis_spec_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "required": [
              "approved_at",
              "approved_by"
            ]
          },
          "open_questions": {
            "not": {
              "contains": {
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "status": {
                    "const": "open"
                  }
                },
                "required": [
                  "blocking",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            }
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "required": [
              "approved_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "execution_mode": {
                "const": "production"
              }
            }
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "host_runtime": {
                "properties": {
                  "fidelity": {
                    "const": "real"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "required": [
              "supersedes_spec_version"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "feature_directory",
              "revision"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "description": "Lowercase UUID. Version 7 is recommended so identifiers sort by creation time.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "description": "Content hash in the form sha256:<64 lowercase hex characters>.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "description": "Full Git object id, 40 or 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "description": "UTC instant in RFC 3339 form with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen. For metadata fields, never for human-facing titles.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    }
  }
}
