{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:evidence-manifest:1",
  "title": "Evidence manifest",
  "description": "The summary that the delivery stage attaches to a draft pull request. It lists, by content hash, the specification, plan, change, gate reports, reviews and documentation checks behind the pull request, the head of the evidence ledger, the assurance levels attained, and the ones that were not. It must always state its limitations. A manifest never hides that something was not verified, and in production mode every adapter that took part must have been real.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "title",
    "summary",
    "ledger",
    "specification",
    "architecture",
    "plan",
    "change",
    "gate_reports",
    "reviews",
    "documentation",
    "assurance",
    "adapters",
    "risk",
    "approvals_required",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "job_id",
        "tenant_id",
        "generated_at",
        "execution_mode",
        "repository"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/uuid"
        },
        "job_id": {
          "$ref": "#/$defs/uuid"
        },
        "tenant_id": {
          "$ref": "#/$defs/uuid"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "execution_mode": {
          "enum": [
            "production",
            "test"
          ]
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_name",
            "base_commit",
            "head_commit"
          ],
          "properties": {
            "full_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "base_commit": {
              "$ref": "#/$defs/gitSha"
            },
            "head_commit": {
              "$ref": "#/$defs/gitSha"
            }
          }
        }
      }
    },
    "title": {
      "$ref": "#/$defs/humanTitle"
    },
    "summary": {
      "$ref": "#/$defs/humanText"
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "head_sequence",
        "head_hash",
        "chain_verified_at"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "head_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "chain_verified_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "spec_version",
        "sha256"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/uuid"
        },
        "spec_version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_version",
        "sha256"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/uuid"
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_sha256",
        "files_changed",
        "insertions",
        "deletions"
      ],
      "properties": {
        "diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "insertions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "outcome",
          "sha256"
        ],
        "properties": {
          "gate_id": {
            "$ref": "#/$defs/slug"
          },
          "outcome": {
            "enum": [
              "PASSED",
              "NOT_APPLICABLE",
              "BLOCKED"
            ],
            "description": "A FAILED gate cannot appear. Delivery happens only after rework cleared it."
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "disposition_ledger_entry_id": {
            "$ref": "#/$defs/uuid",
            "description": "Required for BLOCKED: the ledger entry that records the human decision."
          }
        },
        "if": {
          "properties": {
            "outcome": {
              "const": "BLOCKED"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "then": {
          "required": [
            "disposition_ledger_entry_id"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "verdict",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "code_reviewer",
              "security_reviewer",
              "reliability_reviewer",
              "ux_reviewer",
              "adversarial_reviewer",
              "documentation_reviewer",
              "specification_reviewer",
              "architecture_critic"
            ]
          },
          "verdict": {
            "const": "PASS"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_sha256",
        "gate_report_sha256",
        "review_sha256"
      ],
      "properties": {
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gate_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attained",
        "not_attained"
      ],
      "properties": {
        "attained": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "ledger_entry_id"
            ],
            "properties": {
              "level": {
                "$ref": "#/$defs/assuranceLevel"
              },
              "ledger_entry_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        },
        "not_attained": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "reason"
            ],
            "properties": {
              "level": {
                "$ref": "#/$defs/assuranceLevel"
              },
              "reason": {
                "$ref": "#/$defs/humanText"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "attained": {
              "contains": {
                "type": "object",
                "properties": {
                  "level": {
                    "const": "PRODUCTION_READY"
                  }
                },
                "required": [
                  "level"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "not_attained": {
              "contains": {
                "type": "object",
                "properties": {
                  "level": {
                    "const": "PRODUCTION_READY"
                  }
                },
                "required": [
                  "level"
                ]
              }
            }
          }
        }
      ],
      "description": "PRODUCTION_READY must appear in exactly one of the two lists, so the manifest always says whether it was reached."
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "fidelity",
          "version"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "agent_runtime",
              "sandbox",
              "change_host",
              "artifact_store",
              "store",
              "specification_provider"
            ]
          },
          "fidelity": {
            "enum": [
              "real",
              "fake"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "score",
        "rationale"
      ],
      "properties": {
        "tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "$ref": "#/$defs/humanText"
        }
      }
    },
    "approvals_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "approver",
          "security_approver",
          "org_admin"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/humanText"
      },
      "description": "What was not verified, mocked, skipped or left to a human. Never empty."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "execution_mode": {
                "const": "production"
              }
            }
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "adapters": {
            "items": {
              "properties": {
                "fidelity": {
                  "const": "real"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "description": "Lowercase UUID. Version 7 is recommended so identifiers sort by creation time.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "description": "Content hash in the form sha256:<64 lowercase hex characters>.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "description": "Full Git object id, 40 or 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "description": "UTC instant in RFC 3339 form with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen. For metadata fields, never for human-facing titles.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "assuranceLevel": {
      "enum": [
        "SPECIFIED",
        "IMPLEMENTED",
        "VERIFIED_IN_SANDBOX",
        "VERIFIED_IN_SIMULATOR",
        "VERIFIED_ON_DEVICE",
        "PAPER_VALIDATED",
        "PRODUCTION_READY"
      ]
    }
  }
}
