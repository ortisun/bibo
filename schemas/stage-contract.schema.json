{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:stage-contract:1",
  "title": "Stage contract",
  "description": "The resolved, versioned contract for one stage run. It states the purpose, the typed inputs and where they came from, the preconditions, the risk tier, the methods chosen and the alternatives rejected, the least-privilege capabilities, the deliverables, the machine-verifiable acceptance criteria, the independent evaluator, the budget, the timeout and retry limits, the idempotency and compensation policy, the escalation path and the telemetry. Run and attempt identifiers are metadata. A stage cannot claim success because an agent says so: the evaluator named here must verify evidence and persist its decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "title",
    "purpose",
    "problem_statement",
    "inputs",
    "preconditions",
    "risk",
    "methods",
    "capabilities",
    "deliverables",
    "acceptance_criteria",
    "evaluator",
    "evidence_refs",
    "confidence",
    "assumptions",
    "budget",
    "timeout_and_retries",
    "idempotency",
    "escalation",
    "telemetry"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "stage_kind",
        "job_id",
        "stage_run_id",
        "execution_mode",
        "created_at",
        "domain_profiles"
      ],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/slug",
          "description": "Identifier of the stage definition this contract was resolved from."
        },
        "contract_version": {
          "$ref": "#/$defs/semver"
        },
        "stage_kind": {
          "enum": [
            "INTAKE",
            "REPOSITORY_INTELLIGENCE",
            "SPECIFICATION",
            "DOMAIN_DISCOVERY",
            "ARCHITECTURE",
            "TASK_PLANNING",
            "IMPLEMENTATION",
            "VALIDATION",
            "REVIEW",
            "DOCUMENTING",
            "DOCUMENTATION_REVIEW",
            "DELIVERY",
            "APPROVAL",
            "MERGE"
          ]
        },
        "job_id": {
          "$ref": "#/$defs/uuid"
        },
        "stage_run_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "execution_mode": {
          "enum": [
            "production",
            "test"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "domain_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "title": {
      "$ref": "#/$defs/humanTitle"
    },
    "purpose": {
      "$ref": "#/$defs/humanText"
    },
    "problem_statement": {
      "$ref": "#/$defs/humanText"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "artifact",
          "provenance",
          "trust"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "$ref": "#/$defs/humanText"
          },
          "artifact": {
            "$ref": "#/$defs/artifactRef"
          },
          "schema_ref": {
            "$ref": "#/$defs/schemaRef"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "retrieved_at"
            ],
            "properties": {
              "source": {
                "enum": [
                  "untrusted_external",
                  "repository",
                  "previous_stage",
                  "human",
                  "policy"
                ]
              },
              "produced_by_stage_run_id": {
                "$ref": "#/$defs/uuid"
              },
              "commit_sha": {
                "$ref": "#/$defs/gitSha"
              },
              "retrieved_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          },
          "trust": {
            "enum": [
              "untrusted",
              "trusted_internal"
            ],
            "description": "Untrusted inputs are data, never instructions."
          }
        },
        "if": {
          "properties": {
            "provenance": {
              "properties": {
                "source": {
                  "enum": [
                    "untrusted_external",
                    "repository",
                    "human"
                  ]
                }
              }
            }
          },
          "required": [
            "provenance"
          ]
        },
        "then": {
          "properties": {
            "trust": {
              "const": "untrusted"
            }
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "check"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "$ref": "#/$defs/humanText"
          },
          "check": {
            "enum": [
              "artifact_present",
              "upstream_stage_passed",
              "policy_allows",
              "tool_available",
              "human_approval_recorded"
            ]
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "rationale"
      ],
      "properties": {
        "tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/humanText"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rationale",
          "alternatives_considered",
          "escalation_trigger"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/humanTitle"
          },
          "rationale": {
            "$ref": "#/$defs/humanText"
          },
          "alternatives_considered": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "why_not"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/humanTitle"
                },
                "why_not": {
                  "$ref": "#/$defs/humanText"
                }
              }
            }
          },
          "escalation_trigger": {
            "$ref": "#/$defs/humanText",
            "description": "The measurable condition under which a more complex method is justified."
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_manifest",
        "granted_tools",
        "permissions"
      ],
      "properties": {
        "agent_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          }
        },
        "granted_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Tools the policy engine granted for this run. A subset of the manifest's allowed tools."
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem_read",
            "filesystem_write",
            "network",
            "shell"
          ],
          "properties": {
            "filesystem_read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "filesystem_write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "network": {
              "enum": [
                "none",
                "allowlist"
              ]
            },
            "network_allowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "shell": {
              "enum": [
                "none",
                "sandboxed_typed_wrapper"
              ]
            }
          },
          "if": {
            "properties": {
              "network": {
                "const": "allowlist"
              }
            },
            "required": [
              "network"
            ]
          },
          "then": {
            "required": [
              "network_allowlist"
            ],
            "properties": {
              "network_allowlist": {
                "minItems": 1
              }
            }
          }
        },
        "placement": {
          "enum": [
            "sandbox",
            "host_tool_bridge",
            "not_applicable"
          ]
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "media_type",
          "required"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "$ref": "#/$defs/humanText"
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9.+-]+$"
          },
          "schema_ref": {
            "$ref": "#/$defs/schemaRef"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "verification",
          "machine_verifiable"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "description": {
            "$ref": "#/$defs/humanText"
          },
          "machine_verifiable": {
            "type": "boolean"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "schema_validation",
                  "gate",
                  "test",
                  "review",
                  "human_decision"
                ]
              },
              "ref": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "machine_verifiable": {
            "const": true
          }
        },
        "required": [
          "machine_verifiable"
        ]
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic_gate",
            "independent_reviewer",
            "human",
            "gate_and_reviewer"
          ]
        },
        "gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "reviewer_agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          }
        },
        "reviewer_must_not_see": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "builder_self_assessment",
              "builder_transcript"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "deterministic_gate",
                  "gate_and_reviewer"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "gate_ids"
            ],
            "properties": {
              "gate_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "independent_reviewer",
                  "gate_and_reviewer"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "reviewer_agent",
              "reviewer_must_not_see"
            ],
            "properties": {
              "reviewer_must_not_see": {
                "contains": {
                  "const": "builder_self_assessment"
                }
              }
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ledger_entry_id"
        ],
        "properties": {
          "ledger_entry_id": {
            "$ref": "#/$defs/uuid"
          }
        }
      },
      "description": "Ledger entries the stage consumes as evidence. Empty at creation for stages that produce the first evidence."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "$ref": "#/$defs/humanText"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "statement": {
            "$ref": "#/$defs/humanText"
          },
          "status": {
            "enum": [
              "open",
              "bounded",
              "resolved"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_time_seconds",
        "max_tokens",
        "max_cost_usd",
        "max_compute"
      ],
      "properties": {
        "max_wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_compute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_millicores",
            "memory_mb",
            "disk_mb"
          ],
          "properties": {
            "cpu_millicores": {
              "type": "integer",
              "minimum": 0
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 0
            },
            "disk_mb": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "timeout_and_retries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_timeout_seconds",
        "max_attempts",
        "backoff",
        "retry_on",
        "max_rework_iterations"
      ],
      "properties": {
        "attempt_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "backoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_ms",
            "max_ms",
            "jitter"
          ],
          "properties": {
            "initial_ms": {
              "type": "integer",
              "minimum": 0
            },
            "max_ms": {
              "type": "integer",
              "minimum": 0
            },
            "jitter": {
              "enum": [
                "none",
                "equal",
                "full"
              ]
            }
          }
        },
        "retry_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "TOOL_ERROR",
              "INVALID_OUTPUT",
              "PROVIDER_ERROR",
              "SANDBOX_ERROR",
              "TIMED_OUT",
              "LEASE_LOST"
            ]
          },
          "description": "Failure classes worth retrying. BUDGET_EXHAUSTED and POLICY_DENIED are never retried."
        },
        "max_rework_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_scheme",
        "side_effects"
      ],
      "properties": {
        "key_scheme": {
          "type": "string",
          "minLength": 1,
          "description": "How the idempotency key is built, for example stage_run_id plus input hashes."
        },
        "side_effects": {
          "enum": [
            "none",
            "local_workspace",
            "external_write"
          ]
        },
        "compensating_action": {
          "$ref": "#/$defs/humanText"
        }
      },
      "if": {
        "properties": {
          "side_effects": {
            "const": "external_write"
          }
        },
        "required": [
          "side_effects"
        ]
      },
      "then": {
        "required": [
          "compensating_action"
        ]
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback",
        "escalate_to",
        "on"
      ],
      "properties": {
        "rollback": {
          "$ref": "#/$defs/humanText"
        },
        "escalate_to": {
          "enum": [
            "operator",
            "approver",
            "security_approver",
            "org_admin"
          ]
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "budget_exceeded",
              "rework_limit_reached",
              "stagnation_detected",
              "blocked",
              "needs_human_verdict",
              "policy_violation"
            ]
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_name",
        "attributes",
        "metrics"
      ],
      "properties": {
        "span_name": {
          "$ref": "#/$defs/slug"
        },
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "stage_kind": {
                "enum": [
                  "IMPLEMENTATION"
                ]
              }
            }
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "required": [
              "placement"
            ],
            "properties": {
              "placement": {
                "const": "sandbox"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "description": "Lowercase UUID. Version 7 is recommended so identifiers sort by creation time.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "description": "Content hash in the form sha256:<64 lowercase hex characters>.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "description": "Full Git object id, 40 or 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "description": "UTC instant in RFC 3339 form with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen. For metadata fields, never for human-facing titles.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "semver": {
      "description": "Semantic version, for example 1.2.0.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "artifactRef": {
      "description": "Pointer to an immutable stored artifact by content hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemaRef": {
      "description": "Reference to a versioned JSON Schema by name, version and content hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
