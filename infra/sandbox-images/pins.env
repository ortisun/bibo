# pins.env - every version, digest and checksum the sandbox images are built from.
#
# This is the only place a pin is written. The build scripts read it and pass the values to
# Docker as build arguments, and check-pins.sh compares it with what the upstream projects
# publish. Format: one KEY=VALUE per line, no quotes, no spaces, so a shell can source it and a
# script can parse it. To change a pin, follow "Update a pin" in README.md.
#
# Per-architecture values end in _arm64 or _amd64 (the Docker names for the two platforms).

# --- Fixed clock --------------------------------------------------------------------------------
# Every file time and image timestamp is clamped to this value, so a rebuild does not change a
# digest because of the clock. It is the Rust 1.98.0 dist date, 2026-08-20T00:00:00Z.
SOURCE_DATE_EPOCH=1787184000

# --- Base images, pinned by the digest of the multi-platform index ------------------------------
# rust:1.98.0-slim-trixie is the official Rust image (Debian 13 with gcc, libc-dev, ca-certificates
# and rustc/cargo 1.98.0). The index digest covers every platform. The per-platform manifest
# digests below are what a pull on that platform resolves to; check-pins.sh compares them.
RUST_BASE=rust:1.98.0-slim-trixie@sha256:17d1ba895198f9934c6314ec5346a0d5115372f3243390c3d731e242f35c2f27
RUST_BASE_MANIFEST_arm64=sha256:03772383892cfc106221071fb6094e8b83269888782a160b33af9211f0d11476
RUST_BASE_MANIFEST_amd64=sha256:90fd7674d9f6c35662cbf59ec39c32175511a1b7f49e39adcbe91b7420e5e972
# Distroless cc on Debian 13: glibc, libgcc, libstdc++, CA certificates, no shell, no package manager.
DISTROLESS_BASE=gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e

# --- Rust toolchain -----------------------------------------------------------------------------
# TOOLCHAIN_VERSION must equal the channel in rust-toolchain.toml; build.sh and test.sh check it.
# rustc, cargo and the standard library come from the base image. The two components that image
# leaves out (clippy and rustfmt, both named in rust-toolchain.toml) are downloaded from the dated,
# immutable dist directory and checked against the hashes in the signed channel manifest
# https://static.rust-lang.org/dist/channel-rust-1.98.0.toml (signed by the Rust release key,
# fingerprint 108F66205EAEB0AAA8DD5E1C85AB96E6FA1BE5FE).
TOOLCHAIN_VERSION=1.98.0
RUST_DIST_BASE=https://static.rust-lang.org/dist/2026-08-20
RUST_RELEASE_SIGNING_FINGERPRINT=108F66205EAEB0AAA8DD5E1C85AB96E6FA1BE5FE
CLIPPY_SHA256_arm64=2333ba7932e2bc473f8cc05a41e3d4c65543fc6834ca61da4be5590457e52a9b
CLIPPY_SHA256_amd64=22a5d1ed834c3b94cd5f5b0a7d1c804ca1124b7c1fadaf25583e452e6426ebd7
RUSTFMT_SHA256_arm64=61f29320c8bc790bcf5f82020b7487bb5c6427bed76fd0a9b7241cf1249eaf51
RUSTFMT_SHA256_amd64=0f425a5e8e9826840f4105d71f2e758f55ff21cb1805670dffd2c93e8e0a9a95

# --- Claude Code --------------------------------------------------------------------------------
# Official channel: the native installer (https://claude.ai/install.sh) downloads the binary from
# CLAUDE_URL_BASE and checks it against manifest.json, which Anthropic signs with the release key
# below. The spike ran the musl build (linux-arm64-musl, 172150e3...) on Alpine; this image is
# Debian, so it takes the glibc build of the same release. The host installed 2.1.311 this way (~/.local/share/claude/versions/2.1.311 is the native
# binary; its SHA-256 equals the darwin-arm64 entry of the same manifest). The linux builds below
# are the glibc ones, which run on the Debian base.
CLAUDE_VERSION=2.1.311
CLAUDE_URL_BASE=https://downloads.claude.ai/claude-code-releases
CLAUDE_SIGNING_FINGERPRINT=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
CLAUDE_SHA256_arm64=2e2496c9a8065df93acb0fca2d341f59a6b8777649b2e025ab8c9bcd5eef61f3
CLAUDE_SHA256_amd64=86dc1fcc69498159eaf15f446613e847010f9036bfbbdffd4c49350be8489ada

# --- Codex --------------------------------------------------------------------------------------
# Same channel as the host and as the agent runtime spike (docs/spikes/agent-runtime.md 4.1): the
# npm platform package @openai/codex@0.163.0-linux-<arch>. The image does not carry Node or npm;
# it takes the native files out of the tarball, as fixtures/recordings/agent-cli/images/
# Dockerfile.codex does. The spike checked the registry's SHA-512 (arm64:
# IH2/R+4OarjGvsAf1ll3fdyLwrPgYLl3uzp6u9CyD9sj2Lw+ViDSe3QBZVHdcHJs0eIiZFg6Wprcuy4CRZaUGw==). The
# build checks SHA-256, which BuildKit supports; the arm64 value was computed from the registry
# file and equals the digest GitHub lists for the same file on release rust-v0.163.0. The amd64
# value is that GitHub digest; it has not been built here (UNVERIFIED until an amd64 build).
# CODEX_BINARY_SHA256_* is bin/codex inside the tarball. For arm64 it equals the standalone musl
# binary of the GitHub release, whose sigstore bundle names the identity below.
CODEX_VERSION=0.163.0
CODEX_URL_BASE=https://registry.npmjs.org/@openai/codex/-
CODEX_SIGSTORE_IDENTITY=https://github.com/openai/codex/.github/workflows/rust-release.yml@refs/tags/rust-v0.163.0
CODEX_SHA256_arm64=dc6e7c4d6de71c23a0f60d05e2577ff7eef615b76f22630d58ad384b84763522
CODEX_SHA256_amd64=30efc97738b975940d78b59a9bea115fa34040b732807d54ec35ae6b7528de94
CODEX_BINARY_SHA256_arm64=8a96f66d059d653e68bfd5f3c79337e6f1d7d170d80bf705eb7d0249b34c0ece
CODEX_BINARY_SHA256_amd64=399ff69c431c066e40de318fba45c2b07f45a76b19939d247ee4828fc70c4215

# --- Sandbox user -------------------------------------------------------------------------------
# One numeric user for the agent and verify images, so the supervisor passes the same --user to
# both. Both ids are 10000 or higher, as policies/security.yaml requires. The sidecar has its own.
SANDBOX_UID=10001
SANDBOX_GID=10001
SIDECAR_UID=10003
SIDECAR_GID=10003
