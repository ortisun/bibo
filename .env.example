# Settings for the local development stack (infra/compose and scripts/dev-up.sh).
#
# HOW TO USE
#   Run scripts/dev-up.sh. On the first run it copies this file to .env, fills in
#   POSTGRES_PASSWORD with a random value, and starts the stack. You can also copy
#   the file by hand (cp .env.example .env), but then you must set the password yourself.
#
# RULES FOR THIS FILE
#   * This file is committed. It must never hold a real secret, token or password.
#   * The real values live in .env. Git ignores .env, and policies/security.yaml
#     marks it as a hidden path that no agent may read or write.
#   * Every name that ends in PASSWORD, SECRET, TOKEN or KEY must be empty here.
#     "scripts/ci.sh --self-test-no-secrets" fails the build if one is not.
#   * Do not put a credential in a Compose file. Compose reads it from .env.

# ---- PostgreSQL (the only service in the local stack so far) ----------------------------

# Name of the database user and of the database that the container creates on first start.
# These are not secrets. They are fine to keep as they are.
POSTGRES_USER=factory
POSTGRES_DB=factory

# Password for POSTGRES_USER. LEAVE THIS EMPTY IN THIS FILE.
#
# An empty value is deliberate. If you copy this file without setting a password, Compose
# stops with "required variable POSTGRES_PASSWORD is missing a value", and the PostgreSQL
# image would refuse an empty password as well. A made-up default such as "changeme" would
# silently start a database that anyone on this machine could open, so there is none.
# scripts/dev-up.sh writes a random 48-character password into .env, never into this file.
POSTGRES_PASSWORD=

# Port on this machine where PostgreSQL listens. It is bound to 127.0.0.1 only, so other
# computers cannot reach it. Change the number if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432

# ---- The full local stack (infra/compose/local.yml, started by scripts/local-up.sh) -----------
# These names are read by local.yml, which is a separate Compose project from the PostgreSQL-only
# stack above. A blank value means "use the default written in local.yml". The scripts set the
# ones that matter for a run, so a person rarely needs to touch them. The secret files themselves
# live in infra/compose/secrets/, which Git ignores; nothing secret belongs in this file.

# Folder of the secret files (default infra/compose/secrets) and where Docker mounts them in a container.
FACTORY_SECRETS_DIR=
FACTORY_RUN_SECRETS_DIR=
# Loopback ports of PostgreSQL and the API.
FACTORY_PG_PORT=55432
FACTORY_API_PORT=8080
# Images. Blank means the pinned default. The factory images are built on this machine and never pulled.
FACTORY_PG_IMAGE=
FACTORY_API_IMAGE=
FACTORY_WORKER_IMAGE=
FACTORY_SANDBOX_PROBE_IMAGE=
# Files that configure the factory services. How the worker reaches Docker is a key of its file
# (sandbox.docker_host), not a variable: the worker's docker client runs with an empty environment.
FACTORY_API_CONFIG=
FACTORY_WORKER_CONFIG=
# The user the api and worker containers run as, and the owner of the artifact volume. Blank means 10010 and 10010.
# On a Linux host the secret files must belong to this user (Compose keeps the owner of the host file and the
# services refuse a secret that others can read), so set both to the numbers `id -u` and `id -g` print, and set the
# same two for scripts/backup.sh and scripts/restore.sh.
FACTORY_UID=
FACTORY_GID=
# A folder that holds allowlist.yaml, read-only in the api and the worker. Blank means infra/compose/allowlist.
FACTORY_ALLOWLIST_DIR=
# The host worker's folder (scripts/worker-host.sh, ADR 0036). infra/compose/host-worker.yml mounts its artifacts/ as
# the api's artifact store; that override needs it set. Blank means .local/host-worker in the repository.
FACTORY_HOST_DIR=
# Restart policy and log filter. Throwaway runs (smoke, restore drill) set FACTORY_TEST and FACTORY_RUN_ID
# so that every object they make carries the labels factory.test and factory.run.
FACTORY_RESTART=unless-stopped
FACTORY_LOG=info
FACTORY_TEST=false
FACTORY_RUN_ID=local
