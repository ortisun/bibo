{
  "schema_version": 1,
  "id": "planner",
  "version": "1.0.0",
  "title": "Planner",
  "description": "Turns a frozen specification and an approved architecture into a task graph that a builder can run one task at a time. It reads the repository with read-only tools and writes nothing.",
  "role": "planner",
  "domains": [
    "general-software"
  ],
  "skills": [],
  "allowed_tools": [
    {
      "name": "fs.read",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.list",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.search",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "report.submit",
      "access": "read"
    }
  ],
  "required_evidence": [
    "specification-artifact-hash"
  ],
  "inputs_schema": {
    "name": "planner-input",
    "version": 1,
    "sha256": "sha256:4fca3f4b1d19d2d503c34c0d46842bb02e2b419f119cfe8066b4dcb8dcca057c"
  },
  "outputs_schema": {
    "name": "planner-result",
    "version": 1,
    "sha256": "sha256:a5e6560c92f20e85a8b8a1dd4913f8f1157ed7918b22f2ceb680cd4c93a9fc0f"
  },
  "resource_limits": {
    "max_wall_time_seconds": 900,
    "max_tokens": 200000,
    "max_cost_usd": 3,
    "max_tool_calls": 60,
    "max_delegation_depth": 0
  },
  "permissions": {
    "filesystem": {
      "read": [
        "**"
      ],
      "write": []
    },
    "network": "none",
    "shell": "none",
    "production_access": "none",
    "secrets": "none"
  },
  "permitted_placements": [
    "sandbox"
  ],
  "recommended_models": [
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-sonnet-5-5",
      "tier": "standard",
      "notes": "Splitting a small design into tasks is within what the starting model can do."
    },
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-opus-5-5",
      "tier": "large",
      "notes": "Use when the plan check fails twice or when the design has many parts. The tool's own default is this model, and it is the most expensive."
    },
    {
      "runtime_id": "codex-cli",
      "model": "gpt-6.1-sol",
      "tier": "standard",
      "notes": "The only Codex model named in the recorded runs. Its price tier has not been confirmed, so treat it as standard until the model router says otherwise."
    }
  ],
  "evaluation_suite": {
    "id": "planner-conformance",
    "version": "1.0.0",
    "min_pass_rate": 1.0
  },
  "prompt": {
    "template_path": "agents/planner/prompt.md",
    "template_version": "1.2.0",
    "template_sha256": "sha256:c3c52d3ba1258fa9e889f3082f03bc89a7da650416abfa436519465893198e44"
  }
}
