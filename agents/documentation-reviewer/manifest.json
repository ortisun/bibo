{
  "schema_version": 1,
  "id": "documentation-reviewer",
  "version": "1.0.0",
  "title": "Documentation reviewer",
  "description": "Independent review of the documentation written for a change. It receives the frozen specification, the plan, both diffs, the gate reports and what people answered, never the writer's own account, and it changes nothing.",
  "role": "documentation_reviewer",
  "domains": [
    "general-software"
  ],
  "skills": [],
  "allowed_tools": [
    {
      "name": "fs.read",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.list",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "report.submit",
      "access": "read"
    }
  ],
  "required_evidence": [
    "specification-artifact-hash",
    "diff",
    "gate-report"
  ],
  "inputs_schema": {
    "name": "documentation-reviewer-input",
    "version": 1,
    "sha256": "sha256:1ed45d748aac0704ea0e72a21c5ed537524d84e206cab45258bb40d35a5f895e"
  },
  "outputs_schema": {
    "name": "review-findings",
    "version": 1,
    "sha256": "sha256:ee27adfbdbfcb2c3ddb51643d8df6b8db77fe8c51cb8b0721c7757fe7eb3720f"
  },
  "resource_limits": {
    "max_wall_time_seconds": 600,
    "max_tokens": 120000,
    "max_cost_usd": 1,
    "max_tool_calls": 40,
    "max_delegation_depth": 0
  },
  "permissions": {
    "filesystem": {
      "read": [
        "**"
      ],
      "write": []
    },
    "network": "none",
    "shell": "none",
    "production_access": "none",
    "secrets": "none"
  },
  "permitted_placements": [
    "sandbox"
  ],
  "recommended_models": [
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-sonnet-5-5",
      "tier": "standard",
      "notes": "Comparing a few documents with a diff is within what the starting model can do."
    },
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-opus-5-5",
      "tier": "large",
      "notes": "Use when the starting model's output failed the check twice. The tool's own default is this model, and it is the most expensive."
    },
    {
      "runtime_id": "codex-cli",
      "model": "gpt-6.1-sol",
      "tier": "standard",
      "notes": "The only Codex model named in the recorded runs. Its price tier has not been confirmed, so treat it as standard until the model router says otherwise."
    }
  ],
  "evaluation_suite": {
    "id": "documentation-reviewer-conformance",
    "version": "1.0.0",
    "min_pass_rate": 1.0
  },
  "prompt": {
    "template_path": "agents/documentation-reviewer/prompt.md",
    "template_version": "1.3.0",
    "template_sha256": "sha256:db4ece9788042468ff5d67881eb1a49df248487699d8ced6a5edc6c3223dff15"
  }
}
