  "recommended_models": [
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-sonnet-5-5",
      "tier": "standard",
      "notes": "An investigation of a few tripped probes is a bounded read-only task, and the starting model is enough. ADR 0021 measured 0.12 to 0.25 US dollars a run on this model."
    },
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-opus-5-5",
      "tier": "large",
      "notes": "Use only after two bounded repairs by the starting model have failed the output check, and never as the first attempt. The tool's own default is this model, and it is the most expensive."
    },
    {
      "runtime_id": "codex-cli",
      "model": "gpt-6.1-sol",
      "tier": "standard",
      "notes": "Listed like the other agents, but not a runtime of the troubleshooter: Codex cannot be brokered in subscription mode (ADR 0020), ADR 0021 does not build it, and the routing policy does not give this model to the role."
    }
