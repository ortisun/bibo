{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:agent:builder-report:1",
  "title": "Builder report",
  "description": "What the builder says about one task. It is a record for people. The factory measures the diff, the scope and the gates itself, and no reviewer receives this report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_id",
    "summary",
    "files_changed",
    "commands_run",
    "tests_added",
    "dependency_requests",
    "ignored_instructions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "DONE",
        "BLOCKED",
        "NEEDS_HUMAN"
      ]
    },
    "task_id": {
      "$ref": "#/$defs/slug"
    },
    "summary": {
      "$ref": "#/$defs/humanText"
    },
    "files_changed": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "commands_run": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "exit_code"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "tests_added": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "dependency_requests": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "name",
          "version_req",
          "justification"
        ],
        "properties": {
          "ecosystem": {
            "enum": [
              "cargo",
              "npm",
              "pip",
              "go"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 214
          },
          "version_req": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "justification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      }
    },
    "blocked_reason": {
      "$ref": "#/$defs/humanText"
    },
    "human_question": {
      "$ref": "#/$defs/humanText"
    },
    "ignored_instructions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/humanText"
      },
      "description": "Short descriptions of instructions found inside the data blocks that the agent did not follow. An empty list means none were seen."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "human_question"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DONE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "files_changed": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    }
  }
}
