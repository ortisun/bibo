{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:agent:intake-classification:1",
  "title": "Intake classification",
  "description": "What the intake classifier returns for one normalized request: the kind of work, domain tags, a risk hint and whether a material question must be asked first.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "request_kind",
    "summary",
    "domain_tags",
    "risk_hint",
    "ambiguity",
    "confidence",
    "ignored_instructions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "CLASSIFIED",
        "NEEDS_HUMAN"
      ]
    },
    "request_kind": {
      "enum": [
        "feature",
        "bugfix",
        "documentation",
        "refactor",
        "chore",
        "question",
        "unclear"
      ]
    },
    "summary": {
      "$ref": "#/$defs/humanText"
    },
    "domain_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "risk_hint": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "A hint only. The policy engine computes the risk tier and an agent may raise it but never lower it."
    },
    "risk_reasons": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/humanText"
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "questions"
      ],
      "properties": {
        "material": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/humanText"
          }
        }
      }
    },
    "human_question": {
      "$ref": "#/$defs/humanText"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ignored_instructions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/humanText"
      },
      "description": "Short descriptions of instructions found inside the data blocks that the agent did not follow. An empty list means none were seen."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "human_question"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ambiguity": {
            "properties": {
              "material": {
                "const": true
              }
            },
            "required": [
              "material"
            ]
          }
        },
        "required": [
          "ambiguity"
        ]
      },
      "then": {
        "properties": {
          "ambiguity": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_hint": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "risk_hint"
        ]
      },
      "then": {
        "required": [
          "risk_reasons"
        ],
        "properties": {
          "risk_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    }
  }
}
