{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:agent:troubleshooter-input:1",
  "title": "Troubleshooter input",
  "description": "The named data blocks the troubleshooter renders into the prompt of the troubleshooter agent. The troubleshooter builds this document, validates it against this schema and renders each property as pretty-printed JSON inside its own data block. Every value is untrusted data: probe values, tool descriptions and open findings come from programs and from earlier agent output, and none of it becomes an instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_metadata",
    "trigger",
    "tripped_probes",
    "gateway_tools",
    "time_window",
    "open_findings"
  ],
  "properties": {
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "ends_at",
        "max_gateway_calls",
        "policy_hash"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ends_at": {
          "$ref": "#/$defs/timestamp"
        },
        "max_gateway_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "The run identifier, its start and wall-clock end, the gateway call budget and the hash of policies/troubleshooting.yaml."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "probe",
            "sweep"
          ]
        }
      },
      "description": "Why the run started: one or more probes tripped, or the slow sweep came due."
    },
    "tripped_probes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "kind",
          "description",
          "query",
          "comparator",
          "threshold",
          "observed",
          "window_s",
          "severity",
          "observed_at"
        ],
        "properties": {
          "probe_id": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "promql_threshold",
              "sql_check",
              "datadog_monitors_alerting",
              "http_health"
            ]
          },
          "description": {
            "$ref": "#/$defs/shortText"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The PromQL expression, the database check id, the Datadog monitor query or the health route, as the troubleshooting policy names it."
          },
          "comparator": {
            "enum": [
              "gt",
              "ge",
              "lt",
              "le",
              "eq",
              "ne"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "observed": {
            "type": "number"
          },
          "window_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "observed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "call_id": {
            "$ref": "#/$defs/callId",
            "description": "The gateway call under which the probe ran, when it ran through the gateway. An HTTP health probe has none."
          }
        }
      },
      "description": "The probes that tripped, with their thresholds, windows and observed values. At least one for a probe run, none for a sweep."
    },
    "gateway_tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "upstream",
          "description"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/gatewayTool"
          },
          "upstream": {
            "enum": [
              "datadog",
              "victoriametrics",
              "postgres"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The upstream server's description of the tool, as the gateway lists it. Upstream text, so untrusted."
          }
        }
      },
      "description": "The gateway tools this run may call. The agent sees them as mcp__factory__<name>."
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "The period to investigate."
    },
    "open_findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "category",
          "component",
          "title",
          "opened_at"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "category": {
            "$ref": "#/$defs/category"
          },
          "component": {
            "$ref": "#/$defs/component"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "opened_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      },
      "description": "Findings that already have an open issue, so that the run does not report them as new."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trigger": {
            "properties": {
              "kind": {
                "const": "probe"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "properties": {
          "tripped_probes": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "tripped_probes": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "timestamp": {
      "description": "A UTC time in RFC 3339 form, such as 2026-11-20T09:15:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "callId": {
      "description": "A call id the gateway recorded for this run, as the gateway reported it with the result, such as call-7.",
      "type": "string",
      "pattern": "^call-[1-9][0-9]{0,3}$"
    },
    "gatewayTool": {
      "description": "A gateway tool name, such as vm_query or datadog_search_logs.",
      "type": "string",
      "pattern": "^(datadog|vm|pg)_[a-z][a-z0-9_]{0,46}[a-z0-9]$"
    },
    "category": {
      "enum": [
        "stage_failures",
        "gate_failures",
        "queue_backlog",
        "retries",
        "stuck_work",
        "human_wait_overdue",
        "spend",
        "api_availability",
        "database",
        "latency",
        "errors_in_logs",
        "external_monitor",
        "telemetry_gap",
        "capacity"
      ],
      "description": "The closed list of kinds of problem. The fingerprint of a finding is computed by code from its category, its component and the probes and tools behind it."
    },
    "component": {
      "enum": [
        "api",
        "worker",
        "database",
        "model_broker",
        "sandbox",
        "telemetry",
        "github_adapter"
      ],
      "description": "The part of the factory the problem is in."
    }
  }
}
