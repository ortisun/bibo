{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ortisun:factory:schema:agent:documentation-report:1",
  "title": "Documentation report",
  "description": "What the documentation writer says about its work: the files written, how each item of the documentation plan was handled and the claims it made with their evidence. No reviewer receives this report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "files_written",
    "plan_coverage",
    "claims",
    "ignored_instructions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "DONE",
        "NEEDS_HUMAN"
      ]
    },
    "summary": {
      "$ref": "#/$defs/humanText"
    },
    "files_written": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^(README\\.md|CHANGELOG\\.md|docs/[A-Za-z0-9._/-]+\\.md)$"
      }
    },
    "plan_coverage": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_item",
          "status",
          "files"
        ],
        "properties": {
          "plan_item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "covered",
              "not_applicable",
              "not_covered"
            ]
          },
          "files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "reason": {
            "$ref": "#/$defs/humanText"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_applicable",
                    "not_covered"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "covered"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "files": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence_path"
        ],
        "properties": {
          "claim": {
            "$ref": "#/$defs/humanText"
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "human_question": {
      "$ref": "#/$defs/humanText"
    },
    "ignored_instructions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/humanText"
      },
      "description": "Short descriptions of instructions found inside the data blocks that the agent did not follow. An empty list means none were seen."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "human_question"
        ]
      }
    }
  ],
  "$defs": {
    "slug": {
      "description": "Machine-safe identifier: lowercase letters, digits, dot, underscore and hyphen.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "humanText": {
      "description": "Complete plain-English sentences written for a human reader.",
      "type": "string",
      "minLength": 10,
      "maxLength": 4000,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "humanTitle": {
      "description": "Short plain-English title in sentence case. Machine identifiers, role stamps and pipeline tags belong in separate metadata fields, never in the title.",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "allOf": [
        {
          "not": {
            "pattern": "\\|"
          }
        },
        {
          "not": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+\\s*[:|]"
          }
        },
        {
          "not": {
            "pattern": "^\\[[^\\]]+\\]"
          }
        },
        {
          "not": {
            "pattern": "\\[[A-Z_]+:[^\\]]*\\]"
          }
        }
      ]
    }
  }
}
