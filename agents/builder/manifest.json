{
  "schema_version": 1,
  "id": "builder",
  "version": "1.0.0",
  "title": "Builder",
  "description": "Implements one planned task at a time inside an isolated sandbox, test first. It edits only the source and test files of the task and runs the project's own build and test commands through the typed command wrapper. It cannot commit, push, merge or deploy.",
  "role": "builder",
  "domains": [
    "general-software"
  ],
  "skills": [],
  "allowed_tools": [
    {
      "name": "fs.read",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.list",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.search",
      "access": "read",
      "path_scope": [
        "**"
      ]
    },
    {
      "name": "fs.write",
      "access": "write",
      "path_scope": [
        "src/**",
        "tests/**"
      ]
    },
    {
      "name": "exec.run",
      "access": "execute_sandboxed"
    },
    {
      "name": "report.submit",
      "access": "read"
    }
  ],
  "required_evidence": [
    "unit-test-result",
    "diff"
  ],
  "inputs_schema": {
    "name": "builder-input",
    "version": 1,
    "sha256": "sha256:274d9b95d215743338dfbf4ec913f25d640244de39b31e37aaade4048f61a382"
  },
  "outputs_schema": {
    "name": "builder-report",
    "version": 1,
    "sha256": "sha256:7ce55e51480f6d6e1370cdfe02ad7acbf66655556e3b47f955ed19823873e3ef"
  },
  "resource_limits": {
    "max_wall_time_seconds": 1800,
    "max_tokens": 400000,
    "max_cost_usd": 5,
    "max_tool_calls": 200,
    "max_delegation_depth": 0
  },
  "permissions": {
    "filesystem": {
      "read": [
        "**"
      ],
      "write": [
        "src/**",
        "tests/**"
      ]
    },
    "network": "none",
    "shell": "sandboxed_typed_wrapper",
    "production_access": "none",
    "secrets": "none"
  },
  "permitted_placements": [
    "sandbox"
  ],
  "recommended_models": [
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-sonnet-5-5",
      "tier": "standard",
      "notes": "Implementing one small task test first is within what the starting model can do."
    },
    {
      "runtime_id": "claude-code-cli",
      "model": "claude-opus-5-5",
      "tier": "large",
      "notes": "Use for a task that failed twice at its gates, never as the first attempt. The tool's own default is this model, and it is the most expensive."
    },
    {
      "runtime_id": "codex-cli",
      "model": "gpt-6.1-sol",
      "tier": "standard",
      "notes": "The only Codex model named in the recorded runs. Its price tier has not been confirmed, so treat it as standard until the model router says otherwise."
    }
  ],
  "evaluation_suite": {
    "id": "builder-conformance",
    "version": "1.0.0",
    "min_pass_rate": 1.0
  },
  "prompt": {
    "template_path": "agents/builder/prompt.md",
    "template_version": "1.2.0",
    "template_sha256": "sha256:532f28b64f39a91bef7d97baf8460d8535de18ce25c1c964ce56be5a85d69854"
  }
}
