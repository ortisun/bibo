# Scratch image for the agent runtime spike: Claude Code from the official native release channel.
# Labelled scratch: it is not the production sandbox image (work package s1-sandbox-images owns that).
#
# Build (the only step that needs the network):
#   docker build -f Dockerfile.claude -t ars-claude:2.1.311 <empty directory>
#
# The checksum is the SHA-256 that https://downloads.claude.ai/claude-code-releases/2.1.311/manifest.json
# lists for platform linux-arm64-musl. A mismatch stops the build.
ARG BASE=alpine@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

FROM ${BASE} AS fetch
RUN apk add --no-cache curl
ARG CLAUDE_VERSION=2.1.311
ARG CLAUDE_PLATFORM=linux-arm64-musl
ARG CLAUDE_SHA256=172150e3f9ea07e8e2e2e29862d7d9a25f5c234d8e909e4063df237665bf09b9
RUN curl -fsSL -o /claude "https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/${CLAUDE_PLATFORM}/claude" \
 && echo "${CLAUDE_SHA256}  /claude" | sha256sum -c - \
 && chmod 0755 /claude

FROM ${BASE}
# bash: the Bash tool of Claude Code and the Spec Kit helper scripts need it.
# libgcc and libstdc++: listed by the vendor for Alpine. ca-certificates: TLS to a real provider.
RUN apk add --no-cache bash ca-certificates libgcc libstdc++ \
 && addgroup -g 10001 agent \
 && adduser -D -u 10001 -G agent -h /home/agent agent
COPY --from=fetch /claude /usr/local/bin/claude
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/claude"]
