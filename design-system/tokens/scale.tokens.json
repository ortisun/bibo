{
  "$description": "Theme-independent tokens: type, space, shape, size, motion, layers.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "InterVariable",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SF Mono",
          "Cascadia Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "30px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "leading": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "snug": {
        "$type": "number",
        "$value": 1.35
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "tracking": {
      "caps": {
        "$type": "dimension",
        "$value": "0.06em"
      },
      "tight": {
        "$type": "dimension",
        "$value": "-0.01em"
      },
      "display": {
        "$type": "dimension",
        "$value": "-0.02em"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "0-5": {
      "$type": "dimension",
      "$value": "2px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "1-5": {
      "$type": "dimension",
      "$value": "6px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "3px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "5px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "control": {
      "sm": {
        "$type": "dimension",
        "$value": "28px"
      },
      "md": {
        "$type": "dimension",
        "$value": "32px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "40px"
      }
    },
    "focus-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus-offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "layout": {
    "nav-width": {
      "$type": "dimension",
      "$value": "248px"
    },
    "topbar-height": {
      "$type": "dimension",
      "$value": "56px"
    },
    "content-max": {
      "$type": "dimension",
      "$value": "1320px"
    },
    "banner-height": {
      "$type": "dimension",
      "$value": "28px"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "180ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "260ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "layer": {
    "topbar": {
      "$type": "number",
      "$value": 30
    },
    "banner": {
      "$type": "number",
      "$value": 40
    },
    "popover": {
      "$type": "number",
      "$value": 50
    },
    "dialog": {
      "$type": "number",
      "$value": 100
    },
    "toast": {
      "$type": "number",
      "$value": 110
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(11, 13, 18, 0.06)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 12px rgba(11, 13, 18, 0.08), 0 1px 3px rgba(11, 13, 18, 0.06)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 24px 48px rgba(11, 13, 18, 0.22), 0 4px 12px rgba(11, 13, 18, 0.12)"
    }
  }
}
