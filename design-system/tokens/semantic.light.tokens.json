        "bg": {
          "$type": "color",
          "$value": "{palette.green.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.green.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.green.600}"
        }
      },
      "active": {
        "$description": "Working now.",
        "fg": {
          "$type": "color",
          "$value": "{palette.cobalt.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{palette.cobalt.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.cobalt.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.cobalt.600}"
