{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{palette.ink.50}",
      "$description": "The page behind everything."
    },
    "surface": {
      "$type": "color",
      "$value": "{palette.ink.0}",
      "$description": "Panels, tables, cards."
    },
    "surface-raised": {
      "$type": "color",
      "$value": "{palette.ink.0}",
      "$description": "A panel on a panel: menus, the decision panel."
    },
    "surface-sunken": {
      "$type": "color",
      "$value": "{palette.ink.25}",
      "$description": "Wells: code, inputs, the inside of the untrusted-content frame."
    },
    "surface-hover": {
      "$type": "color",
      "$value": "{palette.ink.50}",
      "$description": "A row or item under the pointer."
    },
    "border": {
      "$type": "color",
      "$value": "{palette.ink.200}",
      "$description": "Dividers and panel edges."
    },
    "border-strong": {
      "$type": "color",
      "$value": "{palette.ink.500}",
      "$description": "Control edges; 3 to 1 against the surface."
    },
    "fg": {
      "$type": "color",
      "$value": "{palette.ink.900}",
      "$description": "Body text and headings."
    },
    "fg-muted": {
