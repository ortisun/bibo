        "bg": {
          "$type": "color",
          "$value": "{palette.orange.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.orange.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.orange.600}"
        }
      },
      "fail": {
        "$description": "Failed or refused.",
        "fg": {
          "$type": "color",
          "$value": "{palette.red.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{palette.red.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.red.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.red.600}"
        }
      },
      "warn": {
        "$description": "Needs attention, does not stop work.",
        "fg": {
          "$type": "color",
          "$value": "{palette.amber.700}"
        },
        "bg": {
          "$type": "color",
          "$value": "{palette.amber.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.amber.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.amber.600}"
        }
      },
      "neutral": {
        "$description": "Not started, not needed, or ended by a person.",
        "fg": {
          "$type": "color",
          "$value": "{palette.ink.600}"
        },
        "bg": {
          "$type": "color",
          "$value": "{palette.ink.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.ink.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.ink.500}"
        }
      }
    },
    "env": {
      "production": {
        "$type": "color",
        "$value": "{palette.crimson.600}",
        "$description": "Banner of the production environment."
      },
      "on-production": {
        "$type": "color",
        "$value": "{palette.ink.0}",
        "$description": "Text on the production banner."
      },
      "test": {
        "$type": "color",
        "$value": "{palette.amber.300}",
        "$description": "Banner of a test or local environment."
      },
      "on-test": {
        "$type": "color",
        "$value": "{palette.ink.950}",
        "$description": "Text on the test banner."
      }
    },
    "untrusted": {
      "edge": {
        "$type": "color",
        "$value": "{palette.amber.600}",
        "$description": "Edge of the untrusted-content frame. Only that frame uses it."
      },
      "stripe": {
        "$type": "color",
        "$value": "{palette.amber.100}",
        "$description": "Stripe of the untrusted-content frame."
      },
      "label": {
        "$type": "color",
        "$value": "{palette.amber.800}",
        "$description": "Label text of the untrusted-content frame."
      },
      "ctl-bg": {
        "$type": "color",
        "$value": "{palette.red.100}",
        "$description": "Background of a made-visible control character."
      },
      "ctl-fg": {
        "$type": "color",
        "$value": "{palette.red.800}",
        "$description": "Text of a made-visible control character."
      }
