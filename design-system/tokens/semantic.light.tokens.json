        "bg": {
          "$type": "color",
          "$value": "{palette.orchid.100}"
        },
        "border": {
          "$type": "color",
          "$value": "{palette.orchid.300}"
        },
        "solid": {
          "$type": "color",
          "$value": "{palette.orchid.600}"
